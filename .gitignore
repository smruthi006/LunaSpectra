.env
.env.*
!.env.example

# Python environments and caches
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg

# Python testing, linting, and type-checking caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Node.js and Frontend build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/coverage/
*.tsbuildinfo

# IDEs and local editor settings
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Local SQLite and database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Scientific data products (preserve .gitkeep and intentionally committed data/sample/)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Large processed datasets and planetary science archive formats
*.parquet
*.fits
*.fit
*.fts
*.lbl
*.lblx
*.pds
*.hdf
*.h5
*.hdf5
*.nc
*.tif
*.tiff
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.7z

# Model artifacts and serialized binaries
models/*
!models/.gitkeep
*.pkl
*.pickle
*.joblib
*.onnx
*.pt
*.pth

# Logs and temporary files
logs/
*.log
tmp/
temp/
*.tmp
*.bak

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
