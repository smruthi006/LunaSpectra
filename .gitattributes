# Default text behavior with normalized LF line endings
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary and scientific archive formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.parquet binary
*.fits binary
*.fit binary
*.fts binary
*.pkl binary
*.joblib binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.zip binary
*.gz binary
